{
  "name": "rayzer-stark-game-admin",
  "productName": "Rayzer Stark Game Admin",
  "version": "1.0.0",
  "description": "Rayzer Stark Game — admin panel.",
  "main": "main.js",
  "author": "Rayzer Stark",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rayzer.starkgameadmin",
    "productName": "Rayzer Stark Game Admin",
    "files": [
      "main.js",
      "config.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
