{
  "name": "rayzer-stark-game",
  "productName": "Rayzer Stark Game",
  "version": "1.0.4",
  "description": "Rayzer Stark Game — client.",
  "main": "bootstrap.js",
  "author": "Rayzer Stark",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "jimp": "^0.22",
    "png-to-ico": "^2",
    "resedit": "^2"
  },
  "build": {
    "appId": "com.rayzer.starkgame",
    "productName": "Rayzer Stark Game",
    "afterPack": "./afterPack.js",
    "files": [
      "bootstrap.js",
      "config.json",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecuteable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
